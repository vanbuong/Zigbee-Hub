menu "ZNP Transport"

    config ZNP_UART_PORT
        int "UART port number"
        default 1
        range 0 2
        help
            UART peripheral to use for CC2652P7 ZNP communication.

    config ZNP_UART_BAUD
        int "UART baud rate"
        default 921600
        help
            ZNP UART baud rate. Common values: 115200, 230400, 460800, 921600.

    config ZNP_GPIO_TX
        int "TX GPIO pin"
        default 2
        help
            ESP32 GPIO connected to CC2652P7 RX (ZNP data).

    config ZNP_GPIO_RX
        int "RX GPIO pin"
        default 32
        help
            ESP32 GPIO connected to CC2652P7 TX (ZNP data).

    comment "CC2652P7 RESET / BSL routed through PCA9538 I2C GPIO expander"

    config ZNP_PCA9538_SDA
        int "PCA9538 I2C SDA GPIO pin"
        default 4
        help
            ESP32 GPIO connected to the PCA9538 SDA line.

    config ZNP_PCA9538_SCL
        int "PCA9538 I2C SCL GPIO pin"
        default 33
        help
            ESP32 GPIO connected to the PCA9538 SCL line.

    config ZNP_PCA9538_I2C_PORT
        int "PCA9538 I2C port number"
        default 0
        range 0 1
        help
            ESP32 I2C peripheral used to talk to the PCA9538.

    config ZNP_PCA9538_ADDR
        hex "PCA9538 7-bit I2C address"
        default 0x70
        range 0x70 0x73
        help
            PCA9538 address (0x70..0x73 set by A0/A1 strapping pins).

    config ZNP_PCA9538_RESET_BIT
        int "PCA9538 bit position for CC2652P7 RESET"
        default 0
        range 0 7
        help
            PCA9538 IO bit driving the CC2652P7 RESET pin (active-low).

    config ZNP_PCA9538_BSL_BIT
        int "PCA9538 bit position for CC2652P7 BSL invoke"
        default 1
        range 0 7
        help
            PCA9538 IO bit driving the CC2652P7 BSL_INVOKE pin (active-low).

    config ZNP_PCA9538_RST_GPIO
        int "PCA9538 RESET GPIO pin (-1 = not wired)"
        default 5
        range -1 39
        help
            ESP32 GPIO connected to the PCA9538 RESET pin (active-low).
            Pulsed low briefly at boot to bring the expander into a known
            state before any I2C transactions. Set to -1 if the PCA9538
            RESET pin is tied directly to VCC (no software control).

    config ZNP_SREQ_TIMEOUT_MS
        int "SREQ response timeout (ms)"
        default 1000
        range 500 10000
        help
            How long to wait for an SRSP after sending an SREQ.

    config ZNP_RESET_TIMEOUT_MS
        int "Reset indication timeout (ms)"
        default 6000
        range 1000 10000
        help
            How long to wait for SYS_RESET_IND after asserting the RESET GPIO.

    config ZNP_AREQ_QUEUE_DEPTH
        int "AREQ queue depth (frames)"
        default 32
        range 8 128
        help
            Number of AREQ frames that can be buffered between the dispatch task
            and the framework consumer.

    config ZNP_RX_TASK_STACK
        int "RX task stack size (bytes)"
        default 4096
        range 2048 16384

    config ZNP_DISPATCH_TASK_STACK
        int "Dispatch task stack size (bytes)"
        default 3072
        range 2048 8192

endmenu
